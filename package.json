    "db:snapshot:export": "node --env-file-if-exists=.env.local-data scripts/local-data/export-user-snapshot.mjs",
    "db:snapshot:import": "node --env-file-if-exists=.env.local-data scripts/local-data/import-user-snapshot.mjs",
    "check": "npm run test:run && npm run typecheck && npm run lint",
    "check:all": "npm run check && npm run build && npm run test:edge && npm run typecheck:edge"
  },
