# Variables pour la migration Lovable Cloud -> Supabase perso.
# Copier en `.env` (NON commité) et remplir. Ne jamais committer les valeurs réelles.

# --- Projet SOURCE (actuel, géré par Lovable Cloud) ---
SOURCE_REF="ggtkirrfgihghlmenrfd"
# Connexion directe (port 5432) — mot de passe DB récupéré côté Lovable / "Open in Supabase"
SOURCE_DB_URL="postgresql://postgres:MOT_DE_PASSE_SOURCE@db.ggtkirrfgihghlmenrfd.supabase.co:5432/postgres"
SOURCE_SERVICE_ROLE_KEY="..."   # pour la copie Storage / auth si besoin

# --- Projet CIBLE (le tien) ---
TARGET_REF="ifpqsyyvytfpossqycpc"
TARGET_DB_URL="postgresql://postgres:MOT_DE_PASSE_CIBLE@db.ifpqsyyvytfpossqycpc.supabase.co:5432/postgres"
TARGET_SERVICE_ROLE_KEY="..."

# Token CLI Supabase (https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN="..."

# --- Storage (endpoints S3-compatibles, clés dans Dashboard -> Storage -> S3 Access Keys) ---
SOURCE_S3_ENDPOINT="https://ggtkirrfgihghlmenrfd.storage.supabase.co/storage/v1/s3"
SOURCE_S3_ACCESS_KEY=""
SOURCE_S3_SECRET_KEY=""
TARGET_S3_ENDPOINT="https://ifpqsyyvytfpossqycpc.storage.supabase.co/storage/v1/s3"
TARGET_S3_ACCESS_KEY=""
TARGET_S3_SECRET_KEY=""
S3_REGION="eu-west-3"   # adapter à la région des projets
