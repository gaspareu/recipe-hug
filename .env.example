# Variables d'environnement front (préfixe VITE_, exposées au client par Vite).
# Ce sont des valeurs publiques (la publishable key est la clé anon Supabase).
# Copier en `.env` et renseigner les valeurs du projet Supabase.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
