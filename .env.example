# Variables d'environnement front (préfixe VITE_, exposées au client par Vite).
# Ce sont des valeurs publiques (la publishable key est la clé anon Supabase).
# Copier en `.env`, puis renseigner une branche ou un projet de développement.
# Ne pas mettre le projet de production par défaut : les écritures du frontend sont réelles.
VITE_SUPABASE_PROJECT_ID=your-development-project-ref
VITE_SUPABASE_URL=https://your-development-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-development-publishable-key
