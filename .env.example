# Variables publiques du frontend pour le projet Supabase de développement.
# Copier ce fichier en `.env.development.local`, puis remplacer les placeholders.
# Ne pas utiliser le projet de production : les écritures du frontend sont réelles.
VITE_SUPABASE_PROJECT_ID=your-development-project-ref
VITE_SUPABASE_URL=https://your-development-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-development-publishable-key
