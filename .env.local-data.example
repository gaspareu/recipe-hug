# Source Supabase (production) : valeurs publiques du projet
SUPABASE_SOURCE_URL=https://ifpqsyyvytfpossqycpc.supabase.co
SUPABASE_SOURCE_PUBLISHABLE_KEY=

# Authentification source : privilégier un JWT temporaire de ta session courante.
SUPABASE_SOURCE_ACCESS_TOKEN=

# Alternative si le compte utilise email/mot de passe (ne pas remplir avec OAuth).
# SUPABASE_SOURCE_EMAIL=
# SUPABASE_SOURCE_PASSWORD=

# Supabase local : valeurs affichées par `supabase status`
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_PUBLISHABLE_KEY=
SUPABASE_LOCAL_EMAIL=local@recipe-hug.test
SUPABASE_LOCAL_PASSWORD=

# Options privées (false par défaut)
SUPABASE_SNAPSHOT_INCLUDE_CONVERSATIONS=false
