{
  "description": "Setup et garde-fous du dépôt recipe-hug pour Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.mjs\"",
            "timeout": 180,
            "statusMessage": "Préparation des dépendances recipe-hug"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/git-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Vérification des garde-fous du dépôt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/git-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
